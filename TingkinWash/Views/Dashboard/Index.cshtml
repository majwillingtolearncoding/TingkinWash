@model TingkinWash.ViewModels.UserDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_DashboardLayout";
}

<!-- WELCOME SECTION -->
<div class="dashboard-welcome">
    <h1>Welcome, @Model.FullName!</h1>
    <p>Manage your laundry bookings and account here.</p>
</div>

<!-- STATISTICS -->
<div class="dashboard-stats">

    <div class="stat-card">
        <h3>Total Bookings</h3>
        <h2>@Model.TotalBookings</h2>
    </div>

    <div class="stat-card">
        <h3>Pending Bookings</h3>
        <h2>@Model.PendingBookings</h2>
    </div>

    <div class="stat-card">
        <h3>Completed Bookings</h3>
        <h2>@Model.CompletedBookings</h2>
    </div>

</div>

<!-- MY BOOKINGS -->
<div class="dashboard-section">
    <h2>My Bookings</h2>
    <p>View and monitor your laundry booking requests.</p>
    <span class="text-muted">No booking records available yet.</span>
</div>

<!-- LAUNDRY SERVICES -->
<div class="dashboard-section">
    <h2>Laundry Services</h2>
    <p>Explore our available laundry services.</p>
    <span class="text-muted">Laundry services will be displayed here.</span>
</div>

<!-- MY PROFILE -->
<div class="dashboard-section">
    <h2>My Profile</h2>

    <p class="profile-info">
        <strong>Full Name:</strong> @Model.FullName
    </p>

    <p class="profile-info">
        <strong>Username:</strong> @Model.Username
    </p>

    <p class="profile-info">
        <strong>Phone Number:</strong> @Model.PhoneNumber
    </p>
</div>
