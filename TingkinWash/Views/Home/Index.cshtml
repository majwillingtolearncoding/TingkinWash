@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-content">
        <span class="hero-label">WELCOME TO TINGKINWASH</span>

        <h1>
            Fresh Clothes.<br />
            Fresh Confidence.
        </h1>

        <p>
            Your trusted partner for convenient,
            reliable, and quality laundry services.
        </p>

        <div class="hero-buttons">
            <a href="#services" class="btn-primary-custom">
                Explore Services
            </a>

            <a href="/Account/Register" class="btn-outline-custom">
                Book a Service
            </a>
        </div>
    </div>
</section>

<!-- SERVICES SECTION -->
<section id="services" class="section-container">

    <div class="section-heading">
        <span>WHAT WE OFFER</span>
        <h2>Our Laundry Services</h2>
        <p>Quality laundry care for your everyday needs.</p>
    </div>

    <div class="service-grid">

        <div class="service-card">
            <div class="service-icon">👕</div>
            <h3>Personal Laundry</h3>
            <p>Professional cleaning for your everyday clothes.</p>
            <a href="/Account/Login">Learn More →</a>
        </div>

        <div class="service-card">
            <div class="service-icon">🧥</div>
            <h3>Dry Cleaning</h3>
            <p>Special care for delicate and formal garments.</p>
            <a href="/Account/Login">Learn More →</a>
        </div>


        <div class="service-card">
            <div class="service-icon">🚚</div>
            <h3>Pick-up and Delivery</h3>
            <p>Convenient laundry collection and delivery.</p>
            <a href="/Account/Login">Learn More →</a>
        </div>

    </div>

</section>

<!-- WHY CHOOSE US -->
<section class="why-section">

    <div class="section-heading">
        <span>WHY TINGKINWASH?</span>
        <h2>Why Choose Our Service?</h2>
    </div>

    <div class="why-grid">

        <div class="why-card">
            <h3>✓ Professional Care</h3>
            <p>We care for your clothes with attention.</p>
        </div>

        <div class="why-card">
            <h3>✓ Affordable Pricing</h3>
            <p>Quality laundry services at reasonable prices.</p>
        </div>

        <div class="why-card">
            <h3>✓ Convenient Service</h3>
            <p>Book your laundry service online.</p>
        </div>

        <div class="why-card">
            <h3>✓ Quality Cleaning</h3>
            <p>Enjoy clean and fresh laundry.</p>
        </div>

    </div>

</section>

<!-- HOW IT WORKS -->
<section class="section-container">

    <div class="section-heading">
        <span>SIMPLE PROCESS</span>
        <h2>How It Works</h2>
    </div>

    <div class="steps-grid">

        <div class="step-card">
            <span>01</span>
            <h3>Choose a Service</h3>
            <p>Select the laundry service you need.</p>
        </div>

        <div class="step-card">
            <span>02</span>
            <h3>Schedule Your Booking</h3>
            <p>Choose your preferred pickup date and time.</p>
        </div>

        <div class="step-card">
            <span>03</span>
            <h3>Enjoy Fresh Laundry</h3>
            <p>Receive your clean and fresh clothes.</p>
        </div>

    </div>

</section>

<!-- ABOUT US -->
<section id="about" class="about-section">

    <div class="about-content">
        <span>ABOUT US</span>
        <h2>Welcome to TingkinWash</h2>

        <p>
            TingkinWash is a laundry service booking and
            management system designed to make laundry
            services more convenient and organized.
        </p>

        <p>
            Our goal is to provide customers with an easy
            way to explore laundry services, submit bookings,
            and monitor their laundry orders.
        </p>
    </div>

</section>

<!-- CONTACT -->
<section id="contact" class="contact-section">

    <div class="section-heading">
        <span>GET IN TOUCH</span>
        <h2>Contact TingkinWash</h2>
        <p>Have questions about our laundry services?</p>
    </div>

    <a href="mailto:your-email@example.com"
       class="btn-primary-custom">
        Contact Us
    </a>

</section>