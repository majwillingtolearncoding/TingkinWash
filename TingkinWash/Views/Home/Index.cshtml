@{
    ViewData["Title"] = "Home";
}

<!-- HERO SECTION -->
<section class="hero-section">
    <div class="hero-overlay"></div>

    <div class="hero-content">
        <span class="hero-label">WELCOME TO TINGKINWASH</span>

        <h1>
            Fresh Clothes.<br />
            <span>Fresh Confidence.</span>
        </h1>

        <p>
            Your trusted partner for convenient, reliable,
            and quality laundry services. Enjoy a cleaner
            and easier laundry experience with us.
        </p>

        <div class="hero-buttons">
            <a href="#services" class="btn-primary-custom">
                Explore Services <span>→</span>
            </a>

            <a href="/Account/Register" class="btn-outline-custom">
                Book a Service
            </a>
        </div>

        <div class="hero-trust">
            <span>✓</span> Convenient Online Booking
            <span>✓</span> Quality Laundry Care
        </div>
    </div>
</section>

<!-- SERVICES SECTION -->
<section id="services" class="section-container services-section">

    <div class="section-heading">
        <span class="section-label">WHAT WE OFFER</span>
        <h2>Our Laundry Services</h2>
        <p>Quality laundry care for your everyday needs.</p>
    </div>

    <div class="service-grid">

        <div class="service-card">
            <div class="service-icon">👕</div>
            <span class="service-number">SERVICE 01</span>
            <h3>Personal Laundry</h3>
            <p>
                Professional cleaning for your everyday
                clothes, keeping them fresh and clean.
            </p>
            <a href="/Account/Login" class="service-link">
                Learn More <span>→</span>
            </a>
        </div>

        <div class="service-card">
            <div class="service-icon">🧥</div>
            <span class="service-number">SERVICE 02</span>
            <h3>Dry Cleaning</h3>
            <p>
                Special care for delicate fabrics,
                formal wear, and your favorite garments.
            </p>
            <a href="/Account/Login" class="service-link">
                Learn More <span>→</span>
            </a>
        </div>

        <div class="service-card">
            <div class="service-icon">🚚</div>
            <span class="service-number">SERVICE 03</span>
            <h3>Pick-up and Delivery</h3>
            <p>
                Enjoy convenient laundry collection
                and delivery with less effort.
            </p>
            <a href="/Account/Login" class="service-link">
                Learn More <span>→</span>
            </a>
        </div>

    </div>
</section>

<!-- WHY CHOOSE US -->
<section class="why-section">

    <div class="section-container">
        <div class="section-heading">
            <span class="section-label">WHY TINGKINWASH?</span>
            <h2>Why Choose Our Service?</h2>
            <p>We make taking care of your laundry simple and convenient.</p>
        </div>

        <div class="why-grid">

            <div class="why-card">
                <div class="why-icon">✦</div>
                <h3>Professional Care</h3>
                <p>We handle your clothes with care and attention.</p>
            </div>

            <div class="why-card">
                <div class="why-icon">₱</div>
                <h3>Affordable Pricing</h3>
                <p>Enjoy quality laundry services at reasonable prices.</p>
            </div>

            <div class="why-card">
                <div class="why-icon">◷</div>
                <h3>Convenient Service</h3>
                <p>Book your preferred laundry service online.</p>
            </div>

            <div class="why-card">
                <div class="why-icon">✓</div>
                <h3>Quality Cleaning</h3>
                <p>Enjoy clean, fresh, and well-cared-for laundry.</p>
            </div>

        </div>
    </div>
</section>

<!-- HOW IT WORKS -->
<section class="section-container process-section">

    <div class="section-heading">
        <span class="section-label">SIMPLE PROCESS</span>
        <h2>How It Works</h2>
        <p>Getting your laundry done is as easy as three simple steps.</p>
    </div>

    <div class="steps-grid">

        <div class="step-card">
            <div class="step-number">01</div>
            <div class="step-icon">🧺</div>
            <h3>Choose a Service</h3>
            <p>Select the laundry service that fits your needs.</p>
        </div>

        <div class="step-card">
            <div class="step-number">02</div>
            <div class="step-icon">📅</div>
            <h3>Schedule Your Booking</h3>
            <p>Choose your preferred pickup date and time.</p>
        </div>

        <div class="step-card">
            <div class="step-number">03</div>
            <div class="step-icon">✨</div>
            <h3>Enjoy Fresh Laundry</h3>
            <p>Receive your clean and fresh clothes.</p>
        </div>

    </div>
</section>

<!-- ABOUT US -->
<section id="about" class="about-section">

    <div class="about-content">
        <div class="about-icon">🫧</div>

        <span class="section-label">ABOUT US</span>
        <h2>Welcome to TingkinWash</h2>

        <p>
            TingkinWash is a laundry service booking and
            management system designed to make laundry
            services more convenient and organized.
        </p>

        <p>
            Our goal is to provide customers with an easy
            way to explore laundry services, submit bookings,
            and monitor their laundry orders.
        </p>

        <a href="/Account/Register" class="btn-primary-custom">
            Get Started <span>→</span>
        </a>
    </div>

</section>

<!-- CONTACT -->
<section id="contact" class="contact-section">

    <div class="contact-content">
        <span class="section-label">GET IN TOUCH</span>
        <h2>Need Help With Your Laundry?</h2>

        <p>
            Have questions about our laundry services?
            We're here to help you.
        </p>

        <a href="mailto:your-email@example.com"
           class="btn-primary-custom">
            Contact Us <span>→</span>
        </a>
    </div>

</section>
