<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - TingkinWash</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light custom-navbar">

            <div class="container">

                <a class="navbar-brand" asp-controller="Home"
                   asp-action="Index">
                    <span class="brand-blue">Tingkin</span>Wash
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link" href="/">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/#services">
                                Services
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/#about">
                                About Us
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="/#contact">
                                Contact
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link login-link"
                               href="/Account/Login">
                                Login
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="signup-button"
                               href="/Account/Register">
                                Sign Up
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container">
            <h3>TingkinWash</h3>
            <p>Book • Wash • Relax</p>
            <p>© 2026 TingkinWash. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>